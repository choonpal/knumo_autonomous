<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scout_mini">

  <xacro:arg name="enable_drive" default="true" />
  <xacro:property name="PI" value="3.1415926535897931" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="${PI/2} 0 -${PI/2}" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/body.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.514618 0.3816 0.10357" />
      </geometry>
    </collision>
  </link>

  <joint name="inertial_joint" type="fixed">
    <parent link="base_link" />
    <child link="inertial_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="inertial_link">
    <inertial>
      <mass value="60" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="2.288641" ixy="0" ixz="0" iyy="5.103976" iyz="0" izz="3.431465" />
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_left_wheel_link" />
    <origin xyz="0.2319755 0.245 -0.100998" rpy="0 0 0" />
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 -0.0367485 0" rpy="-${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.0367485 0" rpy="-${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </collision>
    <inertial>
      <mass value="15" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.6171" ixy="0" ixz="0" iyy="0.6171" iyz="0" izz="0.1361" />
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel_link" />
    <origin xyz="-0.2319755 0.245 -0.100998" rpy="0 0 0" />
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 -0.0367485 0" rpy="-${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.0367485 0" rpy="-${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </collision>
    <inertial>
      <mass value="15" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.6171" ixy="0" ixz="0" iyy="0.6171" iyz="0" izz="0.1361" />
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_right_wheel_link" />
    <origin xyz="0.2319755 -0.245 -0.099998" rpy="0 0 0" />
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0.0367485 0" rpy="${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.0367485 0" rpy="${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </collision>
    <inertial>
      <mass value="15" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.6171" ixy="0" ixz="0" iyy="0.6171" iyz="0" izz="0.1361" />
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel_link" />
    <origin xyz="-0.2319755 -0.245 -0.099998" rpy="0 0 0" />
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0.0367485 0" rpy="${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.0367485 0" rpy="${PI/2} 0 0" />
      <geometry>
        <mesh filename="package://scout_mini_description/meshes/wheel.dae" />
      </geometry>
    </collision>
    <inertial>
      <mass value="15" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.6171" ixy="0" ixz="0" iyy="0.6171" iyz="0" izz="0.1361" />
    </inertial>
  </link>

  <ros2_control name="scout_mini_control" type="system">
    <hardware>
      <plugin>scout_mini_hardware/ScoutMiniHardware</plugin>
      <param name="interface">can0</param>
      <param name="wheel_radius">0.0875</param>
      <param name="wheel_separation">0.490</param>
      <param name="velocity_timeout_sec">0.25</param>
      <param name="robot_state_timeout_sec">0.50</param>
      <param name="driver_state_timeout_sec">1.00</param>
      <!-- 2026-08-08 1.5 에서 2.5 로 올림. scout_mini_hardware.cpp 478행이
           CAN 송신 직전에 이 값으로 클램프한다. 상류(launch linear_speed,
           CommandGuard, scout_mini_waypoint_ekf.yaml)를 모두 2.5로 올려도
           여기서 잘려 실측 대지속도가 1.5에서 평평했다.
           주의 - 이 파일의 주석에 콜론+공백을 쓰면 안 된다. robot_description이
           문자열 그대로 파라미터로 넘어가는데 launch가 YAML로 파싱을 시도해
           "unable to parse the value of parameter robot_description as yaml"
           오류로 런치 전체가 죽는다. -->
      <param name="max_linear_velocity">2.5</param>
      <param name="max_angular_velocity">1.0</param>
      <param name="enable_drive">$(arg enable_drive)</param>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>

</robot>
